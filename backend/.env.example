# Dhaba Support AI Environment Configuration
ENV=development
DEBUG=True

# Database (defaults to local SQLite)
DATABASE_URL=sqlite:///./dhaba_support.db

# AI Provider Settings
# Options: fixture (default zero-key evaluation), mock, gemini, openai, anthropic
AI_PROVIDER=fixture
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=4.0
AI_MAX_RETRIES=2

# Circuit Breaker Configuration
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIME_SECONDS=30.0
