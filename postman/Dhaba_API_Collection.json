{
  "info": {
    "_postman_id": "dhaba-support-ai-collection-v1",
    "name": "Dhaba Support AI — API Collection",
    "description": "Complete Postman collection for Dhaba AI Support Triage System, covering all endpoints: Auth, Tickets, Triage, Refunds, Dashboard, Reports, Audit, System Health, and Security tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has auth token', function () { pm.expect(jsonData.token).to.not.be.empty; });",
                  "if (jsonData.token) { pm.environment.set('admin_token', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dhaba.ai\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Login (Agent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) { pm.environment.set('agent_token', jsonData.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@dhaba.ai\",\n  \"password\": \"Agent@1234\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"]}
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"]}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": {"raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api", "auth", "logout"]}
          }
        }
      ]
    },
    {
      "name": "2. Ticket Management",
      "item": [
        {
          "name": "List Tickets",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{agent_token}}"}],
            "url": {"raw": "{{base_url}}/api/tickets?page=1&per_page=20", "host": ["{{base_url}}"], "path": ["api", "tickets"], "query": [{"key": "page", "value": "1"}, {"key": "per_page", "value": "20"}]}
          }
        },
        {
          "name": "Get Ticket By ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{agent_token}}"}],
            "url": {"raw": "{{base_url}}/api/tickets/{{ticket_id}}", "host": ["{{base_url}}"], "path": ["api", "tickets", "{{ticket_id}}"]}
          }
        },
        {
          "name": "Get Ticket Purchases",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{agent_token}}"}],
            "url": {"raw": "{{base_url}}/api/tickets/{{ticket_id}}/purchases", "host": ["{{base_url}}"], "path": ["api", "tickets", "{{ticket_id}}", "purchases"]}
          }
        },
        {
          "name": "Import Ticket (POST /api/tickets)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{agent_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_id\": \"T-9999\",\n  \"received_at\": \"2024-11-01T10:00:00Z\",\n  \"subject\": \"Postman Integration Test Ticket\",\n  \"body\": \"Testing ticket ingestion from Postman.\",\n  \"app_opens_since_renewal\": 1,\n  \"purchases\": [\n    {\n      \"purchase_id\": \"PUR-9999-A\",\n      \"purchase_type\": \"annual_subscription\",\n      \"amount_inr\": 4999,\n      \"status\": \"success\",\n      \"purchased_at\": \"2024-11-01T09:00:00Z\"\n    }\n  ]\n}"
            },
            "url": {"raw": "{{base_url}}/api/tickets", "host": ["{{base_url}}"], "path": ["api", "tickets"]}
          }
        }
      ]
    },
    {
      "name": "3. Ticket Triage",
      "item": [
        {
          "name": "Triage Direct (POST /triage with T-1001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json();",
                  "pm.test('Has ticket_id', function () { pm.expect(d.ticket_id).to.eql('T-1001'); });",
                  "pm.test('Category is billing', function () { pm.expect(d.category).to.eql('billing'); });",
                  "pm.test('Refund recommended', function () { pm.expect(d.refund.should_refund).to.be.true; });",
                  "pm.test('Refund amount is 4999', function () { pm.expect(d.refund.amount_inr).to.eql(4999); });",
                  "pm.test('Reply draft present', function () { pm.expect(d.reply_draft).to.not.be.empty; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_id\": \"T-1001\",\n  \"received_at\": \"2024-10-01T09:15:00Z\",\n  \"subject\": \"Charged twice for subscription\",\n  \"body\": \"Hi, I was charged twice this month for my annual subscription. I see two transactions of ₹4999 on my credit card statement dated September 28. Please refund the duplicate charge.\",\n  \"app_opens_since_renewal\": 47,\n  \"purchases\": [\n    {\n      \"purchase_id\": \"PUR-1001-A\",\n      \"purchase_type\": \"annual_subscription\",\n      \"amount_inr\": 4999,\n      \"status\": \"success\",\n      \"purchased_at\": \"2024-09-28T10:00:00Z\"\n    },\n    {\n      \"purchase_id\": \"PUR-1001-B\",\n      \"purchase_type\": \"annual_subscription\",\n      \"amount_inr\": 4999,\n      \"status\": \"success\",\n      \"purchased_at\": \"2024-09-28T10:03:00Z\"\n    }\n  ]\n}"
            },
            "url": {"raw": "{{base_url}}/triage", "host": ["{{base_url}}"], "path": ["triage"]}
          }
        },
        {
          "name": "Trigger Triage for Ticket ID (POST /api/tickets/{id}/triage)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{agent_token}}"}],
            "url": {"raw": "{{base_url}}/api/tickets/{{ticket_id}}/triage", "host": ["{{base_url}}"], "path": ["api", "tickets", "{{ticket_id}}", "triage"]}
          }
        },
        {
          "name": "Get Triage History",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{agent_token}}"}],
            "url": {"raw": "{{base_url}}/api/tickets/{{ticket_id}}/triage-history", "host": ["{{base_url}}"], "path": ["api", "tickets", "{{ticket_id}}", "triage-history"]}
          }
        },
        {
          "name": "Retry Triage",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{agent_token}}"}],
            "url": {"raw": "{{base_url}}/api/tickets/{{ticket_id}}/retry-triage", "host": ["{{base_url}}"], "path": ["api", "tickets", "{{ticket_id}}", "retry-triage"]}
          }
        }
      ]
    },
