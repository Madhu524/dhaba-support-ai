            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Policy criteria not met upon secondary verification.\"\n}"
            },
            "url": {"raw": "{{base_url}}/api/refunds/{{refund_id}}/reject", "host": ["{{base_url}}"], "path": ["api", "refunds", "{{refund_id}}", "reject"]}
          }
