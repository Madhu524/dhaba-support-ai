# Dhaba Support AI - Environment Configuration
# Copy this file to .env and fill in your values

APP_ENV=development
APP_DEBUG=false
APP_NAME="Dhaba Support AI"
APP_URL=http://localhost/dhaba-support-ai/public

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dhaba_support
DB_USER=root
DB_PASS=

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
TOKEN_EXPIRY_HOURS=24

# AI Provider: rule_based | openai | gemini
AI_PROVIDER=rule_based
OPENAI_API_KEY=
GEMINI_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=storage/logs/app.log

